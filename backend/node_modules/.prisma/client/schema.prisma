// Prisma Schema for Aureum (simplified for basic app)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String // ADMIN, AUTHENTICATOR, VIEWER
  password  String // Add password field (plain text for demo - NOT SECURE) @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Artwork {
  id               String   @id @default(cuid())
  title            String
  artist           String
  year             String?
  medium           String
  dimensions       String
  metadataCid      String
  imageCids        String // Simplified: CSV or JSON string
  documentCids     String // Simplified: CSV or JSON string
  bindingReference String
  status           String // VERIFIED, BROKEN, UNVERIFIABLE, DISPUTED
  ownerId          String // Reference to User.id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Transfer {
  id              String   @id @default(cuid())
  artworkId       String
  sellerId        String
  buyerId         String?
  transferDate    DateTime
  priceVisibility String // PUBLIC, PARTIES_AND_AUTHORISED, HIDDEN
  txHash          String
  blockNumber     Int
  status          String // PENDING, FINALIZED, EXPIRED, CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
